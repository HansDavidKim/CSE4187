\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 제안 사용자 모델의 두 학습 단계. (a) 행동 토큰을 마스킹하여 복원하는 양방향 GRU에서 48차원 사용자 표현을 추출한다. (b) 78차원 2차 상태특징에 사용자--행동별 reward 계수를 적용해 다섯 행동의 선형 utility를 계산하고, softmax 행동확률을 막대로 나타낸다. 기본 상태는 세션 위치와 경과시간, 직전 이벤트 간격, 과거 행동 횟수 및 직전 행동이며 제곱항과 2변수 교차항을 포함한다.}}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:gru}{{1}{2}{제안 사용자 모델의 두 학습 단계. (a) 행동 토큰을 마스킹하여 복원하는 양방향 GRU에서 48차원 사용자 표현을 추출한다. (b) 78차원 2차 상태특징에 사용자--행동별 reward 계수를 적용해 다섯 행동의 선형 utility를 계산하고, softmax 행동확률을 막대로 나타낸다. 기본 상태는 세션 위치와 경과시간, 직전 이벤트 간격, 과거 행동 횟수 및 직전 행동이며 제곱항과 2변수 교차항을 포함한다}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces $K=4$ 사용자 임베딩 군집 P0--P3의 군집 내 이벤트 빈도(\%). 점은 관측값이고 곡선은 네 행동 범주 사이를 PCHIP으로 연결한 시각적 보간이다.}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:eventmix}{{2}{2}{$K=4$ 사용자 임베딩 군집 P0--P3의 군집 내 이벤트 빈도(\%). 점은 관측값이고 곡선은 네 행동 범주 사이를 PCHIP으로 연결한 시각적 보간이다}{figure.caption.3}{}}
